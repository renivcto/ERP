rules_version = '2';

// 르니브 ERP — Firebase Storage 보안규칙
// 목적: 지출/발주 등 첨부 base64 를 Firestore 문서 밖(Storage)으로 오프로드해
//       DB 비대(1MB/doc 초과·localStorage 포화)를 근절하기 위한 저장소.
// 주의: 이 규칙은 배포 시 콘솔의 기존 규칙을 "덮어쓴다".
//
// ── v2 (2026-08-18) — 직원용 ERP 파일 업로드 도입에 맞춰 조정
//
// 배경: 직원용 ERP 계정도 '로그인한 사용자' 다. 종전 규칙은 인증만 보면
//       전부 허용해서, 직원 계정이 임원용 첨부(견적서·영수증·발주 PDF)까지
//       **목록으로 훑고** 읽거나 덮어쓸 수 있었다.
//
// 이번에 막은 것:
//   · list(목록 조회) 를 전면 차단한다. 앱 코드 어디에도 listAll() 이 없으므로
//     회귀 위험 없이 '통째로 훑기' 를 없앨 수 있다. 이제 정확한 경로를 알아야만
//     파일에 접근할 수 있다.
//   · 직원용 업로드는 staff/<uid>/… 로만 간다(staff/index.html 의 upToStorage).
//     경로가 나뉘어 있어야 나중에 권한을 더 좁힐 때 기준이 생긴다.
//
// ⚠️ 아직 못 막은 것 — 정확한 경로를 아는 직원 계정은 임원용 파일을 읽거나
//    덮어쓸 수 있다. Storage 규칙은 Firestore 를 읽지 못해서(get()/exists() 는
//    Firestore 전용) '이 uid 가 staff_users 에 있는가' 를 규칙 안에서 판별할
//    방법이 없다. 완전히 나누려면 둘 중 하나가 필요하다:
//      ① Cloud Functions 로 직원 계정에 커스텀 클레임(staff:true)을 심고
//         규칙에서 request.auth.token.staff 로 분기  ← 권장
//      ② 임원 계정 이메일을 규칙에 화이트리스트로 박기 (인원 바뀔 때마다 재배포)
//
// 배포: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // 직원용 ERP 업로드 — 자료실 첨부·본문 이미지 (v0.38.0)
    // 크기 상한은 앱(upToStorage)에서도 막지만 여기서 한 번 더 둔다.
    // 아래 전체 match 가 같은 경로를 함께 허용하므로 이 상한은 보조 수단이다.
    match /staff/{allPaths=**} {
      allow get: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // 기존 경로 — erp/ 오프로드, 댓글·영수증·피드 첨부 등
    // read 대신 get 만 준다. read = get + list 라서 read 를 쓰면 목록 조회가 열린다.
    match /{allPaths=**} {
      allow get: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
