// =============================================================================
// Reniv ERP — Firestore Security Rules (v2.3, 2026-05)
// =============================================================================
// 게시 방법:
//   1) Firebase Console -> Firestore Database -> 규칙 탭에서 직접 붙여넣기 -> 게시
//   또는
//   2) firebase deploy --only firestore:rules
// =============================================================================
// v2.3 변경점:
//   - 바이너리 백업 컬렉션 6종 규칙 (v2.1 에서 추가) 유지
//   - 화이트리스트 관리자 이메일의 '본인 문서 자가복구' update 규칙 추가
//     (uid 변경/사고로 본인 문서가 '승인대기'·'삭제됨' 이 돼도 락아웃 방지)
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // 헬퍼 함수
    // ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myData().status == '활성';
    }

    function isAdmin() {
      return isActive() && myData().isAdmin == true;
    }

    function canWrite() {
      return isActive() && (myData().isAdmin == true || myData().permission == 'write');
    }

    // 화이트리스트 관리자 이메일 (index.html의 ADMIN_EMAILS와 동일해야 함)
    function isWhitelistedAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['reniv.cto@gmail.com'];
    }

    // ─────────────────────────────────────────────────────────────
    // users/{uid} — 사용자 프로필
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {

      allow get:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (
          (isWhitelistedAdminEmail()
            && request.resource.data.isAdmin == true
            && request.resource.data.status == '활성')
          || (request.resource.data.isAdmin == false
            && request.resource.data.status == '승인대기'
            && request.resource.data.permission in ['read', null])
        );

      allow update: if isSignedIn() && (
        // 본인은 lastLogin만 업데이트
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastLogin']))
        // v2.3: 화이트리스트 관리자 이메일은 본인 문서를 정상 관리자로 자가복구 가능
        //   (uid 변경/사고로 본인 문서가 '승인대기'·'삭제됨' 이 돼도 락아웃 방지.
        //    결과 문서가 반드시 활성 관리자여야 하므로 권한 강등/삭제엔 쓸 수 없음)
        || (isWhitelistedAdminEmail()
          && request.auth.uid == uid
          && request.resource.data.isAdmin == true
          && request.resource.data.status == '활성')
        // 관리자는 모든 필드 변경 가능 (단, 자기 자신의 isAdmin 해제는 금지 — 락아웃 방지)
        || (isAdmin() && !(request.auth.uid == uid
             && resource.data.isAdmin == true
             && request.resource.data.isAdmin == false))
      );

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // erp_data/{doc} — 메인 ERP 데이터 (meta, shopOrders 등)
    // ─────────────────────────────────────────────────────────────
    match /erp_data/{docId} {
      allow read:  if isActive();
      allow write: if canWrite();
    }

    // ─────────────────────────────────────────────────────────────
    // shared/{doc} — 공유 문서 (gdocs 등)
    // ─────────────────────────────────────────────────────────────
    match /shared/{docId} {
      allow read:  if isActive();
      allow write: if canWrite();
    }

    // ─────────────────────────────────────────────────────────────
    // settings/{key} — API 키 등 민감 설정 (관리자 전용)
    // ─────────────────────────────────────────────────────────────
    match /settings/{key} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 바이너리 백업 컬렉션 (PDF·이미지·첨부) — v2.1 추가 (2026-05)
    //   index.html 의 _saveSharedOrderPdf / _saveSharedOrderClosing /
    //   _saveSharedVendorQuote / _saveSharedVendorAttach / approvalAttachments /
    //   feedImages / itemImages 가 쓰는 컬렉션.
    //   규칙이 없으면 아래 catch-all(if false)에 걸려
    //   'Missing or insufficient permissions' 오류 발생.
    // ─────────────────────────────────────────────────────────────
    match /orderPdfs/{docId}           { allow read: if isActive(); allow write: if canWrite(); }
    match /vendorQuotes/{docId}        { allow read: if isActive(); allow write: if canWrite(); }
    match /vendorAttachments/{docId}   { allow read: if isActive(); allow write: if canWrite(); }
    match /approvalAttachments/{docId} { allow read: if isActive(); allow write: if canWrite(); }
    match /feedImages/{docId}          { allow read: if isActive(); allow write: if canWrite(); }
    match /itemImages/{docId}          { allow read: if isActive(); allow write: if canWrite(); }

    // ─────────────────────────────────────────────────────────────
    // 직원용 ERP (staff/) — v2.4 추가 (2026-08-16)
    //   임원용 데이터(erp_data 등)와 완전 분리. 직원 계정은 아래 두
    //   컬렉션만 접근 가능하고, erp_data/shared/settings 는 규칙 수준에서
    //   읽을 수 없다 (기획서: "민감한 정보는 직원용 ERP에 공개하지 않는다").
    //   임원(users 활성 계정)은 직원용 ERP의 관리자다 (기획서 p3).
    // ─────────────────────────────────────────────────────────────
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.active == true;
    }

    // staff_users/{uid} — 직원 프로필 (이름·전화·직책·아바타·입사일)
    match /staff_users/{uid} {
      // 임원(관리자)과 활성 직원은 명단 열람 가능 (담당자 배정·아바타 표시용)
      allow get, list: if isActive() || isStaff();
      // 자가 등록 — 반드시 승인대기(active:false)·직원(role:staff) 상태로만 생성 가능
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.active == false
        && request.resource.data.role == 'staff';
      // 본인: active/role 을 못 바꾸는 조건으로 프로필 수정 가능
      // 승인(active)·직책 등 관리 변경은 임원용 ERP의 '관리자'(isAdmin)만 —
      //   v2.4.1: isActive → isAdmin 으로 좁힘 (승인 권한을 관리자(송희강 이사 등)로 제한)
      allow update: if
        (isSignedIn() && request.auth.uid == uid
          && request.resource.data.active == resource.data.active
          && request.resource.data.role == resource.data.role)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // staff_data/{doc} — 직원용 데이터 (teams·leaves·leave_policy·library 등)
    //   erp_data 와 같은 {data: JSON, ts} 규약. 활성 직원과 임원만 접근.
    match /staff_data/{docId} {
      allow read, write: if isActive() || isStaff();
    }

    // ─────────────────────────────────────────────────────────────
    // 그 외 모든 경로 — 명시적 거부 (안전장치)
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
