{
 "name": "RENIV NEXUS",
 "short_name": "NEXUS",
 "description": "Virtual RENIV Office",
 "id": "./?app=1",
 "start_url": "./?app=1",
 "scope": "./",
 "display": "standalone",
 "display_override": [
  "standalone",
  "minimal-ui"
 ],
 "orientation": "portrait",
 "background_color": "#eef3ef",
 "theme_color": "#2f6f5c",
 "lang": "ko",
 "prefer_related_applications": false,
 "related_applications": [
  {
   "platform": "webapp",
   "url": "https://renivcto.github.io/ERP/nexus/manifest.webmanifest"
  }
 ],
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}
